FROM node:20-alpine

WORKDIR /app

COPY package.json ./
RUN npm install && npm cache clean --force

COPY . .

EXPOSE 3000

# CI=false prevents warnings from killing the dev server
# WATCHPACK_POLLING needed for file-watch inside Docker on macOS/Windows
ENV CI=false \
    WATCHPACK_POLLING=true \
    CHOKIDAR_USEPOLLING=true

CMD ["npm", "start"]
